                "{{gateway}}"
              ],
              "path": [
                "api",
                "contratos"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"clienteId\": \"{{clienteId}}\",\n  \"freelancerId\": \"{{freelancerParalelo}}\",\n  \"titulo\": \"Contrato paralelo B\",\n  \"valor\": 100.00\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
