        {
          "name": "4.10 Auditoria: ordem por contrato",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{gateway}}/api/auditoria?correlationId={{correlationId}}-ordem",
              "host": [
                "{{gateway}}"
