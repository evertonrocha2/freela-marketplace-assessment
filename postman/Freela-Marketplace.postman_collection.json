                "exec": [
                  "// ordena pelo momento em que a auditoria recebeu cada evento, ou seja, a ordem real de processamento",
                  "const eventos = pm.response.json().slice().sort((a, b) => new Date(a.recebidoEm) - new Date(b.recebidoEm));",
                  "const linhas = [];",
                  "[\"A\", \"B\", \"C\"].forEach(letra => {",
                  "    const id = pm.variables.get(\"contrato\" + letra);",
                  "    const sequencia = eventos.filter(e => e.contratoId === id).map(e => e.eventType);",
                  "    linhas.push({ letra, id, sequencia: sequencia.join(\" → \") });",
                  "    pm.test(`Contrato ${letra}: ${sequencia.join(\" → \")}`, () =>",
                  "        pm.expect(sequencia).to.eql([\"ContratoCriado\", \"EntregaRegistrada\", \"ContratoConcluido\"]));",
                  "});",
