                  "pm.test(\"Republicada no tópico principal\", () => pm.expect(pm.response.json().reenviadoEm).to.be.a(\"string\"));",
                  "",
                  "// espera o relay da outbox e os consumidores antes da proxima chamada",
                  "setTimeout(() => {}, 6000);"
                ]
