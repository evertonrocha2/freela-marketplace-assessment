    {
      "name": "5. Logs centralizados (Loki)",
      "description": "Uma única consulta ao Loki traz os logs da operação inteira, de todos os serviços, pelo `correlationId`. Abra a aba **Visualize** da resposta para ver a tabela.\n\n**No Grafana:** http://localhost:3000/d/freela-rastreamento?var-correlationId=print-001 (troque o valor se mudar a variável `correlationId`).",
      "item": [
        {
          "name": "5.1 Logs da operação por correlationId",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{loki}}/loki/api/v1/query_range?query={service=~\"api-gateway|contrato-service|notificacao-service|reputacao-service|auditoria-service\"} | json | correlationId = `{{correlationId}}`&limit=1000&direction=forward",
              "host": [
                "{{loki}}"
              ],
              "path": [
                "loki",
                "api",
                "v1",
                "query_range"
              ],
              "query": [
                {
                  "key": "query",
                  "value": "{service=~\"api-gateway|contrato-service|notificacao-service|reputacao-service|auditoria-service\"} | json | correlationId = `{{correlationId}}`"
                },
                {
                  "key": "limit",
                  "value": "1000"
                },
                {
                  "key": "direction",
                  "value": "forward"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const resultado = pm.response.json().data.result;",
                  "const linhas = [];",
                  "resultado.forEach(stream => stream.values.forEach(([ts, linha]) => {",
                  "    let j = {};",
                  "    try { j = JSON.parse(linha); } catch (e) { }",
                  "    linhas.push({",
                  "        ts,",
                  "        hora: new Date(Number(ts.slice(0, 13))).toISOString().slice(11, 23),",
                  "        servico: stream.stream.service,",
                  "        mensagem: String(j.message || linha).replace(/\\s+/g, \" \").slice(0, 160)",
                  "    });",
                  "}));",
                  "linhas.sort((a, b) => (a.ts < b.ts ? -1 : a.ts > b.ts ? 1 : 0));",
                  "const servicos = [...new Set(linhas.map(l => l.servico))].sort();",
                  "pm.test(`${linhas.length} linhas de ${servicos.length} serviços numa única consulta`, () =>",
                  "    pm.expect(servicos).to.include.members([\"api-gateway\", \"contrato-service\", \"notificacao-service\", \"reputacao-service\", \"auditoria-service\"]));",
                  "pm.visualizer.set(`",
                  "<style>body{font:12px sans-serif} table{border-collapse:collapse} td,th{border:1px solid #bbb;padding:3px 6px;text-align:left;vertical-align:top} td.s{white-space:nowrap}</style>",
                  "<h3>{{total}} linhas de log, {{qtd}} serviços: {{servicos}}</h3>",
                  "<table><tr><th>hora (UTC)</th><th>serviço</th><th>mensagem</th></tr>",
                  "{{#each linhas}}<tr><td class=\"s\">{{hora}}</td><td class=\"s\">{{servico}}</td><td><code>{{mensagem}}</code></td></tr>{{/each}}</table>`,",
                  "    { linhas, total: linhas.length, qtd: servicos.length, servicos: servicos.join(\", \") });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "6. Trace no Zipkin",
      "description": "Busca os traces da operação pela tag `correlationId`. Um trace por requisição HTTP, cada um passando por gateway, contrato-service, Kafka e os três consumidores. Abra a aba **Visualize**.\n\n**No Zipkin:** http://localhost:9411/zipkin/?annotationQuery=correlationId%3Dprint-001",
      "item": [
        {
          "name": "6.1 Traces da operação por correlationId",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{zipkin}}/api/v2/traces?annotationQuery=correlationId={{correlationId}}&limit=20",
              "host": [
                "{{zipkin}}"
              ],
              "path": [
                "api",
                "v2",
                "traces"
              ],
              "query": [
                {
                  "key": "annotationQuery",
                  "value": "correlationId={{correlationId}}"
                },
                {
                  "key": "limit",
                  "value": "20"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const traces = pm.response.json();",
                  "const esperados = [\"api-gateway\", \"auditoria-service\", \"contrato-service\", \"notificacao-service\", \"reputacao-service\"];",
                  "const resumo = traces.map(t => ({",
                  "    traceId: t[0].traceId,",
                  "    spans: t.length,",
                  "    servicos: [...new Set(t.map(s => (s.localEndpoint || {}).serviceName))].sort().join(\", \")",
                  "}));",
                  "pm.test(`${traces.length} trace(s) encontrado(s) pela tag correlationId`, () => pm.expect(traces.length).to.be.above(0));",
                  "pm.test(\"Trace atravessa gateway, contrato-service, Kafka e os 3 consumidores\", () =>",
                  "    pm.expect(resumo.some(r => esperados.every(s => r.servicos.includes(s)))).to.be.true);",
                  "const maior = traces.slice().sort((a, b) => b.length - a.length)[0] || [];",
                  "const spans = maior.slice().sort((a, b) => a.timestamp - b.timestamp).map(s => ({",
                  "    servico: (s.localEndpoint || {}).serviceName,",
                  "    tipo: s.kind || \"-\",",
                  "    nome: s.name,",
                  "    ms: ((s.duration || 0) / 1000).toFixed(1)",
                  "}));",
                  "pm.visualizer.set(`",
                  "<style>body{font:13px sans-serif} table{border-collapse:collapse;margin-bottom:16px} td,th{border:1px solid #bbb;padding:4px 8px;text-align:left}</style>",
                  "<h3>Traces da operação</h3>",
                  "<table><tr><th>traceId</th><th>spans</th><th>serviços</th></tr>",
                  "{{#each resumo}}<tr><td><code>{{traceId}}</code></td><td>{{spans}}</td><td>{{servicos}}</td></tr>{{/each}}</table>",
                  "<h3>Spans do trace <code>{{traceId}}</code></h3>",
                  "<table><tr><th>serviço</th><th>tipo</th><th>span</th><th>ms</th></tr>",
                  "{{#each spans}}<tr><td>{{servico}}</td><td>{{tipo}}</td><td>{{nome}}</td><td>{{ms}}</td></tr>{{/each}}</table>`,",
                  "    { resumo, spans, traceId: maior.length ? maior[0].traceId : \"\" });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "7. Falha e dead letter topic",
      "description": "Publica um JSON quebrado direto no tópico, pela API do Kafka UI. Os três consumidores falham, a mensagem vai para o `freela.contratos.eventos.dlt` e a auditoria registra uma falha por grupo consumidor. Depois, reprocessa uma delas. **Rode por último.**\n\n**DLT no Kafka UI:** http://localhost:8090 → Topics → `freela.contratos.eventos.dlt` → Messages (os headers `kafka_dlt-*` trazem tópico, partição, offset e exceção de origem).",
      "item": [
        {
          "name": "7.1 Publicar mensagem inválida no tópico (Kafka UI)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{kafkaUi}}/api/clusters/freela-local/topics/freela.contratos.eventos/messages",
              "host": [
                "{{kafkaUi}}"
              ],
              "path": [
                "api",
                "clusters",
                "freela-local",
                "topics",
                "freela.contratos.eventos",
                "messages"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"partition\": 0,\n  \"key\": \"contrato-invalido\",\n  \"content\": \"{isto nao e json\",\n  \"keySerde\": \"String\",\n  \"valueSerde\": \"String\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Mensagem publicada no Kafka\", () => pm.response.to.have.status(200));",
                  "",
                  "// espera o relay da outbox e os consumidores antes da proxima chamada",
                  "setTimeout(() => {}, 6000);"
                ]
              }
            }
          ]
        },
        {
          "name": "7.2 Falhas registradas (DLT)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{gateway}}/api/auditoria/falhas",
              "host": [
                "{{gateway}}"
              ],
              "path": [
                "api",
                "auditoria",
                "falhas"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const falhas = pm.response.json().slice().sort((a, b) => new Date(b.recebidoEm) - new Date(a.recebidoEm));",
                  "pm.test(\"Falhas registradas pela auditoria\", () => pm.expect(falhas.length).to.be.at.least(3));",
                  "const ultima = falhas[0] || {};",
                  "const mesmaOrigem = falhas.filter(f => f.particaoOriginal === ultima.particaoOriginal && f.offsetOriginal === ultima.offsetOriginal);",
                  "pm.test(\"Uma falha por grupo consumidor (notificação, reputação e auditoria)\", () =>",
                  "    pm.expect(mesmaOrigem.map(f => f.grupoConsumidor).sort()).to.eql([\"auditoria-service\", \"notificacao-service\", \"reputacao-service\"]));",
                  "pm.test(\"Guarda tópico, partição e offset de origem\", () =>",
                  "    pm.expect(ultima.topicoOriginal).to.eql(\"freela.contratos.eventos\"));",
                  "pm.collectionVariables.set(\"falhaId\", ultima.id);",
                  "pm.collectionVariables.set(\"falhasAntes\", falhas.length);"
                ]
              }
            }
          ]
        },
        {
          "name": "7.3 Reprocessar a falha",
          "request": {
            "method": "POST",
            "header": [],
