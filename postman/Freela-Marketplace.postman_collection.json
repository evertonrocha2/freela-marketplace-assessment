        {
          "name": "4.5 Registrar entrega B",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Correlation-Id",
                "value": "{{correlationId}}-ordem"
              }
            ],
            "url": {
              "raw": "{{gateway}}/api/contratos/{{contratoB}}/entregas",
              "host": [
                "{{gateway}}"
              ],
              "path": [
                "api",
                "contratos",
                "{{contratoB}}",
                "entregas"
              ]
            }
          },
          "event": [
            {
